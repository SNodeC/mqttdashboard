  "onboarding": {
    "title": "Add a device",
    "body": "Devices appear automatically after their first uplink. Configure your device to send to the connected TTN application, then wait for its first message. No registration on this page is required."
  },
  "lessons": {
    "voltage": {
      "label": "Voltage",
      "title": "What does voltage mean?",
      "explanation": "Voltage is the push of electricity.",
      "points": [
        "Measured in volts (V).",
        "Like water pressure in a pipe.",
        "More push moves electricity more easily."
      ],
      "caption": "Taller water means a stronger push.",
      "question": "What happens to the push when the battery runs low?",
      "icon": "voltage-icon-bolt.svg",
      "point_icons": [
        "voltage-icon-info.svg",
        "voltage-icon-drop.svg",
        "voltage-icon-bolt1.svg"
      ]
    },
    "current": {
      "label": "Current",
      "title": "What does current mean?",
      "explanation": "Current is how much electricity flows.",
      "points": [
        "Measured in amps (A).",
        "Like how much water flows in a pipe.",
        "More lights on means more current."
      ],
      "caption": "More drops flowing means more current.",
      "question": "What happens to the current when we turn on another light?",
      "icon": "voltage-icon-flow.svg",
      "point_icons": [
        "current-icon-info.svg",
        "current-icon-flow1.svg",
        "current-icon-bulb.svg"
      ]
    },
    "power": {
      "label": "Power",
      "title": "What does power mean?",
      "explanation": "Power shows how fast energy is used.",
      "points": [
        "Measured in watts (W).",
        "Power = voltage × current.",
        "More power empties the battery faster."
      ],
      "caption": "Voltage and current work together.",
      "question": "Which uses more power: one light or three lights?",
      "icon": "voltage-icon-sun.svg",
      "point_icons": [
        "power-icon-info.svg",
        "power-icon-times.svg",
        "power-icon-battery1.svg"
      ]
    },
    "battery": {
      "label": "Battery charge",
      "title": "What does battery charge mean?",
      "explanation": "Battery charge shows how full the battery is.",
      "points": [
        "Shown as a percentage (%).",
        "Like the fuel gauge in a car.",
        "A fuller battery lasts longer."
      ],
      "caption": "The battery level is an estimate.",
      "question": "How long could the battery last if we use more power?",
      "icon": "voltage-icon-battery.svg",
      "point_icons": [
        "battery-icon-info.svg",
        "battery-icon-battery1.svg",
        "battery-icon-clock.svg"
      ]
    },
    "temperature": {
      "label": "Temperature",
      "title": "What does temperature mean?",
      "explanation": "Temperature shows how hot something is.",
      "points": [
        "Measured in degrees Celsius (°C).",
        "Too hot can damage the battery.",
        "Panels get warm in the sun."
      ],
      "caption": "The higher the line, the hotter it is.",
      "question": "Why might the temperature rise on a sunny day?",
      "icon": "voltage-icon-therm.svg",
      "point_icons": [
        "temperature-icon-info.svg",
        "temperature-icon-alert.svg",
        "temperature-icon-sun1.svg"
      ]
    }
  },
  "lesson_order": [
    "voltage",
    "current",
    "power",
    "battery",
    "temperature"
  ]
}
